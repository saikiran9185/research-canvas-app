{
  "name": "researchcanvas",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "predev": "npm run sync-assets",
    "dev": "vite",
    "prebuild": "npm run sync-assets",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node test/geometry.test.mjs && node test/interaction.test.mjs && node test/order.test.mjs && node test/editorScope.test.mjs && node test/merge.test.mjs",
    "test:browser": "node test/browser/run.mjs textlayer.html && node test/browser/run.mjs ocr.html && node test/browser/run.mjs annotated-pdf.html",
    "test:all": "npm test && npm run test:browser",
    "app": "node scripts/install-app.mjs",
    "app:build": "node scripts/install-app.mjs --no-open",
    "sync-assets": "node scripts/sync-assets.mjs",
    "lint": "eslint src --no-warn-ignored",
    "check": "npm run lint && tsc --noEmit && npm test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "fractional-indexing": "^4.0.0",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "perfect-freehand": "^1.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.4"
  }
}
